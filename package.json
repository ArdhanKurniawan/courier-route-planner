{
  "name": "courier-route-planner",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:migrate": "node --env-file=.env.migrations.local ./node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.dev.config.ts",
    "db:migrate:testing": "node --env-file=.env.migrations.testing.local ./node_modules/drizzle-kit/bin.cjs migrate --config=drizzle.testing.config.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tidbcloud/serverless": "0.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "flatpickr": "^4.6.13",
    "next": "^16.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^30.1.1",
    "mysql2": "3.24.5",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
