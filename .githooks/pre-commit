#!/bin/sh

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

case "$branch" in
  (main|testing)
    echo ""
    echo "BLOCKED: commit langsung pada branch '$branch' tidak diizinkan."
    echo ""
    echo "Buat branch kerja terlebih dahulu, misalnya:"
    echo "  git switch -c feature/nama-fitur"
    echo "  git switch -c fix/nama-bug"
    echo "  git switch -c chore/nama-pekerjaan"
    echo ""
    exit 1
    ;;
esac

exit 0