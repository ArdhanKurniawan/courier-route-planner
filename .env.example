APP_ENV=development

# Dev APPLICATION URL only; migration credentials remain in separate ignored files.
DATABASE_URL=

# Server-only single-admin configuration. No defaults or real secrets/hashes here.
# Hosted environments require an exact HTTPS origin and independently scoped values.
AUTH_ORIGIN=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_CREDENTIAL_VERSION=

# Separately approved shared limiter service; no provisioning implied.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
